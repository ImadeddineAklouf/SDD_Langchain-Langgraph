# Fournisseur : groq (défaut, gratuit) | ollama (local) | gemini
SDD_PROVIDER=groq
SDD_MODEL=openai/gpt-oss-120b
# Modèle de secours si le quota quotidien du principal est atteint
SDD_FALLBACK_MODEL=openai/gpt-oss-20b
# Clé gratuite : https://console.groq.com/keys
GROQ_API_KEY=
# GOOGLE_API_KEY=   # si SDD_PROVIDER=gemini
