# Fournisseur : gemini (défaut, API Google gratuite) | groq | ollama (LLM local, optionnel)
SDD_PROVIDER=gemini
# Clé gratuite : https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Modèle et secours : à choisir de préférence dans la barre latérale de l'UI, qui liste les modèles
# réellement ouverts pour votre clé. Décommenter pour les fixer (défaut : gemini-3.8-flash, sans secours).
# SDD_MODEL=gemini-3.8-flash
# SDD_FALLBACK_MODEL=
# Gardien : contrôle sémantique par LLM (1 = oui, 0 = contrôles déterministes seuls) et son modèle
# (vide = même modèle que le producteur ; un modèle différent évite de partager ses angles morts).
# SDD_GUARDIAN_SEMANTIC=1
# SDD_GUARDIAN_MODEL=
# Délai maximal d'un appel au modèle (secondes) et niveau de réflexion des modèles Gemini 3
# (minimal | low | medium | high ; plus haut = plus lent).
# SDD_TIMEOUT=120
# SDD_THINKING=low

# --- Si SDD_PROVIDER=groq (et SDD_MODEL=openai/gpt-oss-120b, SDD_FALLBACK_MODEL=openai/gpt-oss-20b) ---
# GROQ_API_KEY=            # clé gratuite : https://console.groq.com/keys
# --- Si SDD_PROVIDER=ollama (SDD_MODEL=qwen3:14b) ---
# SDD_NUM_CTX=16384
