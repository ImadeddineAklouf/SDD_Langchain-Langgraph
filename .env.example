# Fournisseur : ollama (défaut, 100 % local, sans quota) | groq | gemini
SDD_PROVIDER=ollama
# Modèle Ollama (à télécharger avant : ollama pull qwen3:14b). Alternative : gpt-oss:20b
SDD_MODEL=qwen3:14b
# Taille du contexte Ollama en tokens (augmenter si le projet généré grossit)
SDD_NUM_CTX=16384

# --- Si SDD_PROVIDER=groq ---
# SDD_MODEL=openai/gpt-oss-120b
# SDD_FALLBACK_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=            # clé gratuite : https://console.groq.com/keys
# --- Si SDD_PROVIDER=gemini ---
# GOOGLE_API_KEY=
